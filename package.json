{
  "name": "beeminder-cli",
  "version": "0.1.0",
  "private": false,
  "description": "CLI for the Beeminder API (read goals, add and delete datapoints)",
  "license": "MIT",
  "bin": {
    "beeminder": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "generate": "orval",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "bun scripts/build.ts",
    "test": "bun test tests/acceptance tests/unit tests/release",
    "test:integration": "bun test tests/integration",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "commander": "15.1.0"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "5.16.0",
    "@types/bun": "1.4.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "lefthook": "2.2.2",
    "orval": "8.48.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
